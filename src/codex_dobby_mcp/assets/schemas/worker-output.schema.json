{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "summary": {
      "type": "string"
    },
    "completeness": {
      "type": "string",
      "enum": ["full", "partial", "blocked"]
    },
    "important_facts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "refused": {
      "type": "boolean",
      "description": "Set to true ONLY when you are explicitly refusing to do the requested work (out of scope, policy block, missing required permissions). Set false for ordinary failures or partial completion (use completeness=blocked for those)."
    },
    "file_diffs": {
      "type": "array",
      "description": "Per-file pre/post snippets for files you modified. Use [] when you did not modify any files or when the wrapper can capture diffs from the filesystem unaided.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "description": "Absolute or repo-relative path of the modified file."
          },
          "oldText": {
            "type": ["string", "null"],
            "description": "Pre-run contents, or null for newly created files."
          },
          "newText": {
            "type": ["string", "null"],
            "description": "Post-run contents, or null for deleted files."
          },
          "truncated": {
            "type": "boolean",
            "description": "Whether the file is too large or binary to faithfully represent."
          }
        },
        "required": ["path", "oldText", "newText", "truncated"]
      }
    },
    "review_execution": {
      "description": "Parent execution manifest for orchestrated multi-agent reviews. Dobby cross-checks it against private Codex session rollouts; null for every other run.",
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "protocol": {
              "type": "string",
              "enum": ["multi_agent_v2"]
            },
            "agents": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "review_agent": {
                    "type": "string",
                    "enum": ["generalist", "security", "performance", "architecture", "correctness", "ux", "regression"]
                  },
                  "task_name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "status": {
                    "type": "string",
                    "enum": ["completed", "partial", "blocked", "failed"]
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["review_agent", "task_name", "status", "summary"]
              }
            }
          },
          "required": ["protocol", "agents"]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "summary",
    "completeness",
    "important_facts",
    "next_steps",
    "files_changed",
    "warnings",
    "refused",
    "file_diffs",
    "review_execution"
  ]
}
